#!/bin/sh

set -eu

if [ "$#" -lt 1 ]; then
    echo "tap-test: missing test program" >&2
    exit 2
fi

PROGRAM=$1
shift

# GLib 2.39.92 uses randomized property tests. One seed observed on Trixie
# reproducibly crashes the historical gvariant serialiser test, while this
# pinned seed has been checked repeatedly. Keep the archive CI deterministic
# without changing the preserved upstream source or omitting gvariant.
SEED=R02S00000001000000020000000300000004

exec "$PROGRAM" -k --tap --seed="$SEED" "$@"
